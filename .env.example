# ============================================================
# מייל שמקבל את ההודעות מ-EasySend (IMAP)
# ============================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password

# ============================================================
# שליחת תשובות חזרה (SMTP)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================================
# מייל שלך לescalation
# ============================================================
ESCALATION_EMAIL=your-personal-email@gmail.com

# ============================================================
# רשת ביטחון בלבד: הבוט מגיב מיידית דרך IMAP IDLE (push בזמן אמת),
# המספר הזה הוא רק גיבוי למקרה שחיבור ה-IDLE נופל בשקט
# ============================================================
POLL_INTERVAL_SECONDS=30

# ============================================================
# אפשרות א' — מומלץ על נטפרי: Gemini (עובד כמו בפייתון שלך)
# aistudio.google.com/apikey → Get API key → חינמי
# ============================================================
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash   # ברירת מחדל, אפשר גם gemini-2.5-flash

# ============================================================
# אפשרות ב' — Azure AI Foundry (Claude / GPT-4o)
# ai.azure.com → הproject שלך → Deployments → העתיקי Endpoint + Key
# ============================================================
AZURE_FOUNDRY_ENDPOINT=https://YOUR-PROJECT.eastus.models.ai.azure.com
AZURE_FOUNDRY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_FOUNDRY_MODEL=claude-3-5-sonnet   # או: gpt-4o

# ============================================================
# אפשרות ב' — Azure OpenAI ישיר (אם יש resource קיים)
# ============================================================
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ============================================================
# אפשרות ג' — GitHub Models (חינמי, לפיתוח בלבד)
# ============================================================
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
