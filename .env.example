# ============================================================
# תיבת Gmail — לא ערוץ ההודעות הראשי! משמשת רק ל:
# (א) קבלת תשובות נציג אנושי אחרי escalation
# (ב) שליחת מיילי קוד אימות (OTP) לזיהוי משתמשים
# ============================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-email@gmail.com
IMAP_PASS=your-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ============================================================
# Meta WhatsApp Cloud API — ערוץ ההודעות היחיד לתקשורת עם המשתמשים
# developers.facebook.com → ה-App שלך → WhatsApp → API Setup
# ============================================================
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
# WHATSAPP_BUSINESS_ACCOUNT_ID=1234567890   # לא בשימוש כרגע (רק לניהול תבניות בעתיד)
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WHATSAPP_API_VERSION=v21.0                # ברירת מחדל; מטא מפסיקה תמיכה בגרסאות ישנות מדי כמה שנים
WHATSAPP_WEBHOOK_PORT=3002
# WHATSAPP_DRY_RUN=true                     # לוג בלבד, בלי שליחה אמיתית — לבדיקות

# ============================================================
# מייל שלך לescalation
# ============================================================
ESCALATION_EMAIL=your-personal-email@gmail.com

# ============================================================
# תדירות בדיקת מיילים
# ============================================================
POLL_INTERVAL_SECONDS=30

# ============================================================
# אפשרות א' — מומלץ על נטפרי: Gemini (עובד כמו בפייתון שלך)
# aistudio.google.com/apikey → Get API key → חינמי
# ============================================================
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash   # ברירת מחדל, אפשר גם gemini-2.5-flash

# ============================================================
# אפשרות ב' — Azure AI Foundry (Claude / GPT-4o)
# ai.azure.com → הproject שלך → Deployments → העתיקי Endpoint + Key
# ============================================================
AZURE_FOUNDRY_ENDPOINT=https://YOUR-PROJECT.eastus.models.ai.azure.com
AZURE_FOUNDRY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_FOUNDRY_MODEL=claude-3-5-sonnet   # או: gpt-4o

# ============================================================
# אפשרות ב' — Azure OpenAI ישיר (אם יש resource קיים)
# ============================================================
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ============================================================
# אפשרות ג' — GitHub Models (חינמי, לפיתוח בלבד)
# ============================================================
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# אימות משתמשים — OAuth Microsoft GDT
# portal.azure.com → App registrations → הApp שלך
# Redirect URI להוסיף: https://your-domain.com/auth/callback
# ============================================================
OAUTH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OAUTH_TENANT_ID=greandreanteam.onmicrosoft.com
OAUTH_REDIRECT_URI=https://your-domain.com/auth/callback
OAUTH_PORT=3000

# ============================================================
# ביצוע אוטומטי של הרשאות Azure (אופציונלי)
# portal.azure.com → App registrations → New registration
# Permissions needed: Graph API → User.Read.All
#                     Azure RBAC → User Access Administrator (על הסבסקריפשנס הרלוונטיות)
# ============================================================
# AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
