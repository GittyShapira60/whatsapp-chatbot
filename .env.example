# ============================================================
# קובץ דוגמה — העתיקי ל-.env ומלאי ערכים אמיתיים.
# בפריסה ב-Azure: הערכים מוגדרים ב-Container App (סודות כ-secrets), לא בקובץ.
# שורות בלי # הן חובה — בלעדיהן הבוט לא עולה. שורות עם # הן אופציונליות.
# ============================================================

# ============================================================
# ספק AI ראשי — Azure OpenAI
# ai.azure.com → המשאב (chatbot9) → Deployments → שם הפריסה
# portal.azure.com → המשאב → Keys and Endpoint → Endpoint + KEY 1
# ============================================================
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_DEPLOYMENT=gpt-4.1                              # שם הפריסה (עמודת Name ב-Deployments)
# AZURE_OPENAI_FALLBACK_DEPLOYMENT=gpt-4.1-mini              # פריסת גיבוי בזמן עומס (אם אין — עובר ל-Gemini)
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small   # חיפוש סמנטי בבסיס הידע (בלי זה — חיפוש לפי מילות מפתח)
# AZURE_OPENAI_API_VERSION=2025-04-01-preview                # ברירת מחדל

# ============================================================
# ספק AI גיבוי — Gemini
# משמש כשהספק הראשי עמוס / חרג ממכסה / לא זמין.
# aistudio.google.com/apikey → Get API key
# ============================================================
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# ============================================================
# ספקי AI נוספים (לא בשימוש כרגע)
# סדר עדיפות בקוד: Claude → Azure OpenAI → Gemini → Azure Foundry → GitHub Models.
# ⚠️ אם ANTHROPIC_API_KEY מוגדר — Claude הופך לספק הראשי במקום Azure OpenAI.
# ============================================================
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# BOT_CLAUDE_MODEL=claude-opus-5-5          # ברירת מחדל
# BOT_CLAUDE_EFFORT=low                     # low (מהיר, מתאים לצ'אט) / medium / high
# AZURE_FOUNDRY_ENDPOINT=https://YOUR-PROJECT.eastus.models.ai.azure.com
# AZURE_FOUNDRY_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AZURE_FOUNDRY_MODEL=gpt-4o
# GITHUB_MODEL=gpt-4o

# ============================================================
# Meta WhatsApp Cloud API — ערוץ ההודעות היחיד מול המשתמשים
# developers.facebook.com → ה-App → WhatsApp → API Setup
# ============================================================
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890
WHATSAPP_VERIFY_TOKEN=choose-any-random-string
WHATSAPP_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_WEBHOOK_PORT=3002
# WHATSAPP_API_VERSION=v21.0                # ברירת מחדל
# WHATSAPP_DRY_RUN=true                     # לוג בלבד, בלי שליחה אמיתית — לבדיקות

# ============================================================
# תיבת Gmail של הבוט — לא ערוץ הודעות למשתמשים. משמשת רק ל:
# (א) שליחת קוד אימות (OTP)  (ב) שליחת פניות לנציג  (ג) קבלת תשובות הנציג
# הסיסמה היא App Password של Google, לא הסיסמה הרגילה.
# ============================================================
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-bot-email@gmail.com
IMAP_PASS=your-app-password

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465                               # הקוד שולח תמיד ב-465 (SSL)
SMTP_USER=your-bot-email@gmail.com
SMTP_PASS=your-app-password

# ============================================================
# העברה לנציג אנושי
# ============================================================
ESCALATION_EMAIL=agent-email@example.com    # לכאן נשלחות פניות והתראות; תשובה ממנה חוזרת למשתמש
POLL_INTERVAL_SECONDS=10                    # כל כמה שניות לבדוק אם הנציג ענה
HANDOFF_TTL_HOURS=24                        # אחרי כמה שעות הבוט חוזר לענות אם הנציג לא ענה (ברירת מחדל: 2)

# ============================================================
# אימות משתמשים (OTP במייל) לשאלות ידע
# ============================================================
VERIFIED_EMAIL_DOMAINS=idf.il,greendreamteam.onmicrosoft.com   # דומיינים מורשים, מופרדים בפסיק

# ============================================================
# Redis — מצב שיחות
# ============================================================
# REDIS_URL=redis://redis:6379              # ברירת מחדל (הקונטיינר ב-docker-compose)

# ============================================================
# משתנים שהקוד דורש כדי לעלות (בדיקה ב-index.js),
# אבל הזרימה הנוכחית לא משתמשת בהם. אפשר לשים ערך כלשהו.
# ============================================================
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AZURE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# רק להרצה מקומית מאחורי נטפרי — לא להגדיר בענן!
# מבטל את בדיקת תעודות ה-TLS בכל החיבורים היוצאים.
# ============================================================
# NODE_TLS_REJECT_UNAUTHORIZED=0
